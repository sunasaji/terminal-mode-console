# Copy this file to ~/.config/terminal-mode-console/env, replace the token,
# and make it readable only by your user (chmod 600).
TMCON_TOKEN=replace-with-a-random-token

# The secure default is to listen on loopback only. Use Tailscale Serve or
# another TLS reverse proxy when connecting from a phone or glasses.
HOST=127.0.0.1
PORT=3456

# Log/message language for the server and CLI (a code under locales/, e.g. ja, en).
# Auto-detected from LC_ALL / LC_MESSAGES / LANG when unset; falls back to English.
# The WebUI is unaffected by this and follows the browser language.
# TMCON_LANG=ja

# Optional examples:
# PROVIDER_CLAUDE=claude
# PROVIDER_CODEX=codex
# CODEX_APPROVAL_POLICY=on-request
# LLM_BASE_URL=http://localhost:11434/v1
# The local LLM's model. Optional — with nothing set, a loaded model from the backend's
# own list is used. Set it only to pin one, using the ID the backend returns as-is
# (an ID the backend does not have is rejected).
# LLM_MODEL=
# Claude's model. Used as the default when neither the WebUI dropdown nor the API's model
# specifies one. An alias (opus/sonnet/haiku/fable/default) or a full ID; unset means the
# Claude Code default. A pick in the WebUI dropdown is remembered in
# ~/.tmcon/session-metadata.json and takes precedence.
# CLAUDE_MODEL=opus

# Codex's model. Used as the default when neither the WebUI nor the API specifies one.
# The available concrete IDs are fetched dynamically from the Codex App Server's model/list.
# A pick in the WebUI dropdown is remembered in ~/.tmcon/session-metadata.json and takes
# precedence.
# CODEX_MODEL=your-model-id
