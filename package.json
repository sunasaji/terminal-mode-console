{
  "name": "terminal-mode-console",
  "version": "0.3.0",
  "description": "Independent server that speaks the same HTTP API as the Even Realities G2 Terminal Mode app. A multi-device console for driving one shared session from PC, phone, glasses, and CLI. Works with Claude / Codex / local LLMs (LM Studio/Ollama/llama.cpp). Zero core dependencies. Not affiliated with Even Realities.",
  "type": "module",
  "keywords": [
    "even-realities",
    "even-g2",
    "terminal-mode",
    "claude-code",
    "codex",
    "local-llm",
    "ollama",
    "lm-studio",
    "agent",
    "cli",
    "sse"
  ],
  "homepage": "https://github.com/sunasaji/terminal-mode-console#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sunasaji/terminal-mode-console.git"
  },
  "bugs": {
    "url": "https://github.com/sunasaji/terminal-mode-console/issues"
  },
  "author": "sunasaji",
  "bin": {
    "tmcon": "server.mjs",
    "tmcon-cli": "bin/tmcon-cli.mjs"
  },
  "scripts": {
    "start": "node server.mjs",
    "cli": "node bin/tmcon-cli.mjs",
    "test": "node --test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:md": "markdownlint \"**/*.md\"",
    "lint:css": "stylelint \"web/**/*.css\" --allow-empty-input",
    "lint:html": "htmlhint \"web/**/*.html\"",
    "spell": "cspell \"**/*.{mjs,js,md,json,html}\" --no-progress",
    "lint:all": "npm run lint && npm run lint:md && npm run lint:html && npm run spell",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "engines": {
    "node": ">=20"
  },
  "optionalDependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.252",
    "@openai/codex-sdk": "^0.151.0"
  },
  "files": [
    "server.mjs",
    "bus.mjs",
    "i18n.mjs",
    "agents/",
    "bin/",
    "web/",
    "locales/",
    "docs/",
    "systemd/",
    "README.md",
    "README.ja.md",
    "NOTICE.md",
    "NOTICE.ja.md",
    "LICENSE"
  ],
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "cspell": "^10.3.3",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "htmlhint": "^1.9.2",
    "markdownlint-cli": "^0.49.1",
    "prettier": "^3.9.8",
    "stylelint": "^17.15.0",
    "stylelint-config-standard": "^40.0.0"
  }
}
